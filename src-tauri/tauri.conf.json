{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BufferX",
  "version": "2.0.0",
  "identifier": "ir.amirsrad.bufferx",
  "build": {
    "beforeDevCommand": "pnpm --dir app dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir app build",
    "frontendDist": "../build/web"
  },
  "app": {
    "windows": [
      {
        "title": "BufferX",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": null,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/BufferX.PolicyCheck"],
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) Amirsalar Saberi rad",
    "shortDescription": "ISO 8583 and banking cryptography workbench",
    "longDescription": "BufferX decodes, edits, and rebuilds ISO 8583 buffers and provides MAC, PIN block, symmetric crypto, RSA, TLV, and IranSystem tooling for banking operators."
  }
}
