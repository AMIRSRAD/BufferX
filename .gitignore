# ── Build output ────────────────────────────────────────────────
# Every toolchain writes under build/: CMake, Cargo, and Vite are each
# configured to target a subfolder, so this one line covers all of them and
# `rm -rf build` is always a safe clean.
build/

# Stragglers from a toolchain invoked by hand, outside the configured paths.
target/
dist/
cmake-build*/
out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json

# ── Dependencies ────────────────────────────────────────────────
node_modules/
third_party/
# Tauri regenerates these from tauri.conf.json and the capability files.
src-tauri/gen/

# Generated WebAssembly artifacts (produced by scripts/build-wasm.sh)
app/public/wasm/

# ── Incidental build products ───────────────────────────────────
*.tsbuildinfo
.eslintcache
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# ── Editors / OS ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ── Local secrets and scratch ───────────────────────────────────
# Nothing containing keys or PINs should ever be committed.
*.pem
*.key
.env
.env.*
!.env.example
